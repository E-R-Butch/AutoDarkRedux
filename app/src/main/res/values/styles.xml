<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Material 3 Migration: Theme.MaterialComponents -> Theme.Material3, add Dynamic Colors support -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- M3 will generate colors from Dynamic Color (Monet) if available, fallback to baseline -->
        <!-- Keep custom attrs for compat, but M3 will override -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialCircleIconViewStyle">@style/MaterialCircleIconView</item>
        <!-- Edge-to-edge: enable drawing behind system bars -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.Transparent" parent="AppTheme">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AppTheme.Transparent.ActionBar" parent="AppTheme.Transparent">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.Transparent.DarkActionBar" parent="AppTheme.Transparent">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.BottomSheetDialogDayNight" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.XposedManager" parent="Theme.Material3.DayNight">
        <item name="android:colorEdgeEffect">?attr/colorPrimary</item>
        <item name="colorPrimary">@color/google_blue_600</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorSwitchThumbNormal">@color/material_grey_300</item>
        <item name="android:colorForeground">@color/material_grey_500</item>
    </style>

    <style name="Widget.ActionBar" parent="ThemeOverlay.Material3.Toolbar.Surface" />

    <style name="Widget.ActionBarLight" parent="ThemeOverlay.Material3.Toolbar.Surface" >
        <item name="colorOnPrimary">?attr/colorOnSurface</item>
    </style>

    <style name="CardBaseStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:background">?attr/colorSurfaceVariant</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/permission_title_text_size</item>
        <item name="android:layout_marginStart">@dimen/permission_margin_title_start</item>
    </style>

    <style name="CardStyle" parent="CardBaseStyle"/>

    <style name="CardButton">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/permission_button_size</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:drawablePadding">24dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="CardProgress" parent="Widget.AppCompat.ProgressBar"/>

    <style name="ManagerAppListTextAppearance" parent="TextAppearance.Material3.BodyMedium"/>

    <style name="SimpleDialogStyle" parent="ThemeOverlay.Material3.Dialog"/>

    <style name="BaseDialogTextAppearance" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="MaterialCircleIconView">
        <item name="iconForegroundChroma">100</item>
        <item name="iconBackgroundChroma">600</item>
        <item name="android:background">@drawable/shape_circle_icon_background</item>
        <item name="android:tintMode">src_in</item>
        <item name="android:backgroundTintMode">src_in</item>
    </style>



</resources>
